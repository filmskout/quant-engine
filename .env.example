# ── Execution ────────────────────────────────────────────────────────────
# Venue is Hyperliquid TESTNET. Without keys the engine runs in shadow mode:
# real book pricing, no order submitted.
HL_ADDRESS=
HL_PRIVATE_KEY=

# Real-money arming. Must equal this exact string, nothing else works.
# Leave empty. See README "Why live trading is gated".
LIVE_TRADING=

# ── Brain: 0G Compute (verifiable TEE inference) ─────────────────────────
# Get a key: https://pc.0g.ai -> connect wallet -> deposit 0G -> API Keys.
# Shown once, no recovery. Without it the engine uses the rule-based fallback.
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=deepseek-v4-pro

# Set to "off" to skip the LLM entirely and use deterministic rules.
BRAIN=

# ── Risk limits (USD) ────────────────────────────────────────────────────
MAX_ORDER_NOTIONAL=50
MAX_TOTAL_EXPOSURE=250

# ── Runtime ──────────────────────────────────────────────────────────────
PORT=8770
TICK_MS=60000
TOP_N=5
